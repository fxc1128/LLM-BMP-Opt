  "mathematical_mapping_kb": {
    "metadata": {
      "description": "用于将结构化需求转换为数学形式化表达的规则库",
      "version": "2.0"
    },
    "optimization_objectives": {
      "mapping_rules": [
        {
          "domain_concept": "Sediment reduction",
          "desc": "增大泥沙的削减率",
          "semantic_tags": [
            "水变清",
            "水土保持",
            "减少泥沙"
          ],
          "evaluator": "SEIMS",
          "indicator": "Sediment_Reduction_Rate (削减率)",
          "math_symbol": "R_{sediment}",
          "optimization_sense": "max"
        },
        {
          "domain_concept": "总磷削减TP reduction",
          "desc": "增大总磷的削减率",
          "semantic_tags": [
            "减少污染",
            "降磷",
            "治污",
            "改善水质"
          ],
          "evaluator": "SWAT",
          "indicator": "TP_Reduction_Rate (削减率)",
          "math_symbol": "R_{TP}",
          "optimization_sense": "max"
        },
        {
          "domain_concept": "总氮削减TN reduction",
          "desc": "增大总氮的削减率",
          "semantic_tags": [
            "减少污染",
            "降氮",
            "治污",
            "改善水质"
          ],
          "evaluator": "SWAT",
          "indicator": "TN_Reduction_Rate (削减率)",
          "math_symbol": "R_{TN}",
          "optimization_sense": "max"
        },
        {
          "domain_concept": "总成本total cost",
          "desc": "降低方案的总成本，即实施所有BMP的花费最少，不考虑BMP所创造的经济收入和维护成本",
          "semantic_tags": [
            "总成本",
            "降低成本",
            "省钱",
            "预算控制",
            "经济最优",
            "少花钱"
          ],
          "evaluator": "BMP_cost",
          "indicator": "Cost (净成本)",
          "math_symbol": "C_{total}",
          "optimization_sense": "min"
        },
        {
          "domain_concept": "净花费Net cost",
          "desc": "降低方案的净成本，即考虑BMP的实施成本、维护成本以及BMP所创造的经济收入后的净花费",
          "semantic_tags": [
            "降低净成本",
            "收益增大",
            "维护成本"
          ],
          "evaluator": "BMP_net_cost",
          "indicator": "Net_Cost (净成本)",
          "math_symbol": "C_{net}",
          "optimization_sense": "min"
        },
        {
          "domain_concept": "SWAT+ FtCreek HRU sediment yield",
          "desc": "Executable SWAT+ FtCreek HRU-level sediment-yield minimization using CONS_PRAC BMP choices.",
          "semantic_tags": [
            "SWAT+",
            "FtCreek",
            "HRU",
            "sediment",
            "sedyld",
            "contour",
            "conservation practice"
          ],
          "evaluator": "swat",
          "indicator": "hru_ls_aa.sedyld sum",
          "math_symbol": "Y_{sed,hru}",
          "optimization_sense": "min",
          "model_profile": "swatplus_ftcreek"
        }
      ],
      "sense_dictionary": {
        "max": [
          "提升",
          "增加",
          "最大化",
          "提高",
          "收益",
          "削减率"
        ],
        "min": [
          "降低",
          "减少",
          "最小化",
          "控制",
          "成本",
          "负荷"
        ]
      }
    },
    "decision_variables": {
      "spatial_discretization": {
        "description": "决策变量x_{i}的空间下标 i 的定义",
        "discretization_types": [
          {
            "name": "Confiled",
            "desc": "农田/地块单元",
            "math_notation": "i \\in \\Omega_{field}",
            "definition": "集合 \\Omega_{field} 表示所有农田地块单元"
          },
          {
            "name": "HRU",
            "math_notation": "i \\in \\Omega_{hru}",
            "definition": "集合 \\Omega_{hru} 表示所有水文响应单元"
          },
          {
            "name": "Slope_position",
            "math_notation": "i \\in \\Omega_{slope}",
            "definition": "集合 \\Omega_{slope} 表示坡位单元"
          }
        ]
      },
      "variable_value": {
        "values": "???????code???{????:1?????:2??????:3?????:4??????:5???/???:6????:7}",
        "description": "变量的具体取值范围和物理意义",
        "modes": [
          {
            "implementation_mode": "Type_Selection",
            "math_notation": "x_{i} = BMP_k",
            "domain": "BMP_k \\in \\{0, 1, 2, ..., M\\}",
            "meaning": "k表示在地块 i 实施措施 k，0表示不实施, "
          },
          {
            "implementation_mode": "Area_Proportion",
            "math_notation": "x_{i} = (k,p_{i,k})",
            "domain": "p_{i,k} \\in [0.0, 1.0]",
            "meaning": "连续变量：表示在地块 i 实施措施 k 的面积比例 (0 <= p <= 1)。注：当p=0，即表示不布设措施"
          },
          {
            "implementation_mode": "Time_Schedule",
            "math_notation": "x_{i} = (k,t_{i,k})",
            "domain": "t_{i,k} \\in T_{years}",
            "meaning": "整数变量：表示在地块 i 实施措施 k 的具体年份"
          }
        ]
      }
    },
    "constraint_library": {
      "description": "约束条件的数学模板匹配",
      "templates": [
        {
          "type": "Resource_Limitation",
          "logic_rule": "LHS <= RHS",
          "semantic_tags": [
            "预算",
            "资金",
            "总面积限制",
            "上限",
            "不够用",
            "最多",
            "不超过"
          ],
          "mathematical_form": "\\sum_{i} \\sum_{k} (Cost_{k} \\cdot Area_{i} \\cdot p_{i,k}) \\le Budget_{limit}",
          "example": "总成本不能超过100万"
        },
        {
          "type": "Demand_Satisfaction",
          "logic_rule": "LHS >= RHS",
          "semantic_tags": [
            "达标",
            "至少",
            "削减目标",
            "任务要求",
            "底线",
            "需满足"
          ],
          "mathematical_form": "\\sum_{i} Benefit(x_{i}) \\ge Target_{value}",
          "example": "泥沙削减率至少达到20%"
        },
        {
          "type": "Spatial_Relation",
          "logic_rule": "Conditional (If-Then / Either-Or)",
          "semantic_tags": [
            "邻接",
            "上游影响下游",
            "连片",
            "互斥",
            "只能选一个"
          ],
          "mathematical_form": "\\sum_{k} x_{i,k} \\le 1 (互斥) \\text{ OR } x_{i,up} \\le x_{j,down} (依赖)",
          "example": [
            "每个地块只能选择一种措施",
            "上下游相邻的两个空间单元不同时配置措施"
          ]
        },
        {
          "type": "Physical_feasibility",
          "logic_rule": "x_i ∈ K_{feasible}",
          "semantic_tags": [
            "这里已经选择",
            "这块不能"
          ],
          "mathematical_form": "x_i \\in K_{feasible}(Slope_i, Landuse_i)",
          "example": "地块物理适宜性约束（如：陡坡只能种树）"
        }
      ]
    },
